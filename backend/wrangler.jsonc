{
  "name": "sleeping-dragon-ledger",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sleeping-dragon-ledger-online",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "keep_vars": true
}
